{
  "name": "we-invoice",
  "private": true,
  "version": "0.1.0",
  "description": "Free invoicing and eFaktura (Peppol) for Slovak sole traders and small companies, with VAT reports and simple bookkeeping. Data stays encrypted in the user's own Google Drive.",
  "author": {
    "name": "White Eagles & Co. s.r.o.",
    "url": "https://whiteeagles.sk/"
  },
  "license": "MIT",
  "homepage": "https://github.com/JaffarSk24/WE-Invoice",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaffarSk24/WE-Invoice.git"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.js",
    "dev:desktop": "cross-env NODE_ENV=development electron .",
    "build": "vite build --config app/vite.config.js",
    "build:web": "vite build --config app/vite.config.js --mode web",
    "preview:web": "vite preview --config app/vite.config.js --mode web",
    "test": "vitest run",
    "test:gateway": "npm --prefix gateway test",
    "test:perf": "vitest run --config vitest.perf.config.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:legislation": "node scripts/check-legislation.mjs",
    "pack:desktop": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.3",
    "lucide": "^1.52.0",
    "pdfmake": "^0.3.12",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.whiteeagles.weinvoice",
    "productName": "WE Invoice",
    "directories": {
      "output": "release.nosync"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.cjs",
      "!desktop/scripts/**",
      "!desktop/**/*.test.js",
      "desktop/assets/*.png",
      "packages/core/peppol/providers.json",
      "oauth-credentials.json",
      "icon.png"
    ],
    "afterPack": "./desktop/scripts/adhoc-sign.cjs",
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.business",
      "minimumSystemVersion": "10.15",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WE Invoice"
    },
    "asarUnpack": [
      "icon.png",
      "desktop/assets/*.png"
    ],
    "artifactName": "WE-Invoice-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "JaffarSk24",
        "repo": "WE-Invoice",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright (c) 2026 White Eagles & Co. s.r.o."
  },
  "dependencies": {
    "nodemailer": "^10.1.7"
  }
}
