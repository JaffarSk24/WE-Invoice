# Copy to .env on the server. Never commit the real .env.
HOST=127.0.0.1
PORT=8787
APP_VERSION=0.1.0
LOG_LEVEL=info
CORS_ORIGINS=https://jaffarsk24.github.io
TRUST_PROXY=true

# Waitlist e-mails (ask the owner which mail service whiteeagles.sk uses)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Open data API of the Financial Administration (registered by the owner)
FS_OPENDATA_API_KEY=

# Owner's admin endpoints (waitlist CSV, stats)
ADMIN_TOKEN=

# Signs beta invite tokens
BETA_HMAC_SECRET=

# SQLite file (waitlist, invite codes, public data cache)
DATABASE_PATH=/data/gateway.sqlite
