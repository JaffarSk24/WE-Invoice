# Copy to .env on the server. Never commit the real .env.
HOST=127.0.0.1
PORT=8787
APP_VERSION=0.1.5
LOG_LEVEL=info
# Browser origins allowed by CORS (the site and the dev server)
CORS_ORIGINS=https://jaffarsk24.github.io,http://localhost:5173
# nginx sits in front: trust X-Forwarded-For
# Proxies whose X-Forwarded-For is trusted (proxy-addr names or CIDRs); never "true"
TRUST_PROXY=loopback,uniquelocal
# Public address of this gateway
PUBLIC_URL=https://invoice-api.whiteeagles.sk

# SQLite file (public data cache, counters)
DATABASE_PATH=/data/gateway.sqlite

# Open data API of the Financial Administration (registered by the owner at
# opendata.financnasprava.sk). Without the key company lookups answer
# without DIČ and the VAT reliability check answers NOT_CONFIGURED.
FS_OPENDATA_API_KEY=
FS_OPENDATA_URL=https://iz.opendata.financnasprava.sk/api
# Identifiers of the lists (GET /api/lists with the key shows them all):
# VAT payers, reasons for cancellation, deleted payers (§ 52 ods. 8), and
# subjects registered for income tax (their DIČ)
FS_LIST_VAT_PAYERS=ds_dphs
FS_LIST_CANCELLATION_REASONS=ds_dphz
FS_LIST_DELETED=ds_dphv
FS_LIST_TAX_SUBJECTS=ds_dsrdp

# Owner's admin endpoint (counters): a long random string
ADMIN_TOKEN=

# Peppol proxy: the allow-list comes from packages/core/peppol/providers.json.
# PROVIDERS_FILE overrides its location; PROVIDER_BASE_URLS adds or replaces
# the base URL of a provider that published its API after the release,
# as JSON {"providerId":"https://..."} ("<id>-sandbox" for the sandbox).
PROVIDERS_FILE=
PROVIDER_BASE_URLS=

# Public upstreams (defaults are the current public addresses)
RPO_URL=https://api.statistics.sk/rpo/v1
ARES_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest
VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
ECB_URL=https://www.ecb.europa.eu/stats/eurofxref
EKASA_RECEIPT_URL=https://ekasa.financnasprava.sk/mdu/api/v1/opd/receipt/find
PEPPOL_SML_ZONE=edelivery.tech.ec.europa.eu
# Also try the legacy "B-" + MD5 CNAME record of the SML (off by default)
PEPPOL_SML_LEGACY_CNAME=false
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_CONCURRENT=8
# Multiplies every per-route rate limit (0 disables, tests only)
RATE_LIMIT_SCALE=1
